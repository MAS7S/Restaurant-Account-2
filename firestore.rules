rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_config/invites {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      allow write: if request.auth != null && request.auth.token.email == 'malekshahbien@gmail.com';
    }
    match /restaurants/{docId} {
      allow read: if request.auth != null && request.auth.token.email.lower() in resource.data.memberEmails;
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.token.email.lower() in request.resource.data.memberEmails
        && (
          request.auth.token.email == 'malekshahbien@gmail.com'
          || request.auth.token.email.lower() in get(/databases/$(database)/documents/app_config/invites).data.owners
        );
      allow update: if request.auth != null
        && request.auth.token.email.lower() in resource.data.memberEmails
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && (
          request.auth.uid == resource.data.ownerUid
          || request.resource.data.memberEmails == resource.data.memberEmails
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
  }
}
